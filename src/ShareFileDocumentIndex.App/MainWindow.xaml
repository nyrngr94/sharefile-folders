<Window x:Class="ShareFileDocumentIndex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShareFile Document Index Report" Height="560" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign in panel -->
        <StackPanel x:Name="SignInPanel" Grid.Row="0">
            <TextBlock Text="Sign in with your ShareFile account" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
            <TextBlock Text="A browser window will open to ShareFile's own sign-in page (including any MFA prompt). After you sign in, you'll land on a page showing raw JSON -- find &quot;code&quot;: &quot;...&quot; inside the &quot;args&quot; section, copy just that value, and paste it below." TextWrapping="Wrap" Margin="0,0,0,10" />

            <Button x:Name="SignInButton" Content="Sign In with ShareFile" Click="SignInButton_Click" Width="180" HorizontalAlignment="Left" />

            <StackPanel x:Name="CodeEntryPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="Paste the code from the browser page here:" Margin="0,0,0,4" />
                <TextBox x:Name="CodeBox" Margin="0,0,0,8" />
                <Button x:Name="ContinueButton" Content="Continue" Click="ContinueButton_Click" Width="100" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock x:Name="SignInStatus" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Folder selection panel -->
        <StackPanel x:Name="FolderPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="Select a client folder" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
            <CheckBox x:Name="IncludeLinksCheck" Content="Include document links (adds one API call per document, slower)" IsChecked="True" />
        </StackPanel>

        <ListBox x:Name="FolderListBox" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Visibility="{Binding ElementName=FolderPanel, Path=Visibility}">
            <Button x:Name="RefreshButton" Content="Refresh Folder List" Click="RefreshButton_Click" Margin="0,0,10,0" />
            <Button x:Name="GenerateButton" Content="Generate Report..." Click="GenerateButton_Click" Width="150" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="ProgressBar" Height="16" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
