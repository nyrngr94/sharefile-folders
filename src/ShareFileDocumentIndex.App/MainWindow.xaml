<Window x:Class="ShareFileDocumentIndex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShareFile Document Index Report" Height="480" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign in panel -->
        <StackPanel x:Name="SignInPanel" Grid.Row="0">
            <TextBlock Text="Sign in with your ShareFile account" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Email" />
            <TextBox x:Name="EmailBox" Margin="0,2,0,8" />

            <TextBlock Text="Password" />
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8" />

            <Button x:Name="SignInButton" Content="Sign In" Click="SignInButton_Click" Width="120" HorizontalAlignment="Left" />

            <TextBlock x:Name="SignInStatus" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Folder selection panel -->
        <StackPanel x:Name="FolderPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="Select a client folder" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
            <CheckBox x:Name="IncludeLinksCheck" Content="Include document links (adds one API call per document, slower)" IsChecked="True" />
        </StackPanel>

        <ListBox x:Name="FolderListBox" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Visibility="{Binding ElementName=FolderPanel, Path=Visibility}">
            <Button x:Name="RefreshButton" Content="Refresh Folder List" Click="RefreshButton_Click" Margin="0,0,10,0" />
            <Button x:Name="GenerateButton" Content="Generate Report..." Click="GenerateButton_Click" Width="150" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="ProgressBar" Height="16" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
